# Server
PORT=3000
# Sign-in is Google only (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and ALLOWED_EMAILS below);
# on a public address the app stays locked without them. Locally (127.0.0.1) there is no gate.
# Public URL of this app (used for the Google OAuth redirect)
APP_URL=http://localhost:3000
# Where imported media, renders and the JSON database live
DATA_DIR=./data

# Google Photos Picker API (https://developers.google.com/photos/picker)
# Create an OAuth "Web application" client in Google Cloud Console, enable the
# "Photos Picker API", and add  ${APP_URL}/auth/google/callback  as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Claude as the "AI director" (picks the best moments, writes hooks,
# captions and hashtags). Without it the app falls back to motion/audio heuristics.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: path to a bold .ttf/.otf font used for on-screen text
FONT_FILE=
