    "opentype.js": "^1.3.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^7.0.2"
  }
}
