{
  "name": "rollcut",
  "version": "0.1.0",
  "private": true,
  "description": "Turn your Google Photos pet footage into ready-to-post 10–20s vertical shorts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
